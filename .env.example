# ========== 华裳纪生产配置模板 ==========
# 1) 把本文件复制为 .env.local 后填写真实值
# 2) 域名必须是公网 https
# 3) 有 DATABASE_URL 时执行: pnpm db:push

# 站点公开 URL（生产必填，用于 canonical / 支付回调）
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google / Bing 验证（可选）
GOOGLE_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION_HTML=
BING_SITE_VERIFICATION=

# --- 支付：生产用微信支付 V3 直连 ---
# mock = 本地演示（无需真实证书，走 /api/billing/mock-pay 自动加次数）
# wechat_direct = 微信支付 V3 直连
PAYMENT_MODE=wechat_direct

# 微信支付 V3 必填（在微信商户平台获取）：
WECHAT_MCHID=替换为微信商户号
WECHAT_APPID=替换为公众号/小程序 AppID（须与商户号绑定）
WECHAT_API_V3_KEY=替换为 APIv3 密钥（微信商户平台「API安全」中设置）
# 商户 API 私钥文件路径（apiclient_key.pem），权限 600，不入仓
WECHAT_PRIVATE_KEY_PATH=/etc/wechat/apiclient_key.pem
# 商户证书序列号（API 安全页面可查，或从 apiclient_cert.pem 计算）
WECHAT_CERT_SERIAL_NO=
# 默认使用 NEXT_PUBLIC_SITE_URL 拼接，按需覆盖
# WECHAT_NOTIFY_URL=https://your-domain.com/api/billing/webhook

# 本地开发可改回：PAYMENT_MODE=mock

# --- 运营口令（生产禁止默认值）---
ADMIN_PASSWORD=请改成足够长的随机口令

# --- 单位经济：填真实 Coze 单次出图成本（元）---
# 算法建议：近 7 天 Coze 账单金额 ÷ 成功生成次数（含失败重试摊销）
ESTIMATED_COST_CNY_PER_GENERATION=0.50

# --- 首充 ---
FIRST_PURCHASE_DISCOUNT_ENABLED=true
FIRST_PURCHASE_DISCOUNT_FEN=200

# --- 生产存储（多实例必开）---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/huashangji
