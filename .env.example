# 站点公开 URL（生产环境必填，用于 canonical、sitemap、Open Graph）
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Search Console - Meta 标签验证（推荐）
# 在 Search Console 选择「HTML 标签」方式，复制 content 值填入此处
GOOGLE_SITE_VERIFICATION=

# Google Search Console - HTML 文件验证（可选，与 Meta 标签二选一）
# 填入 Google 提供的文件名，如 google1234567890abcdef.html
# 应用会自动在对应路径返回验证内容
GOOGLE_SITE_VERIFICATION_HTML=

# Bing Webmaster Tools 验证（可选）
BING_SITE_VERIFICATION=
