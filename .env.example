# ========== 华裳纪生产配置模板 ==========
# 1) 把本文件复制为 .env.local 后填写真实值
# 2) 域名必须是公网 https
# 3) 有 DATABASE_URL 时执行: pnpm db:push

# 站点公开 URL（生产必填，用于 canonical / 支付回调）
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google / Bing 验证（可选）
GOOGLE_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION_HTML=
BING_SITE_VERIFICATION=

# --- 支付：生产用 xunhupay ---
PAYMENT_MODE=xunhupay
XUNHUPAY_APPID=替换为虎皮椒APPID
XUNHUPAY_APPSECRET=替换为虎皮椒APPSECRET
XUNHUPAY_GATEWAY=https://api.xunhupay.com/payment/do.html
XUNHUPAY_NOTIFY_URL=https://your-domain.com/api/billing/webhook
XUNHUPAY_RETURN_URL=https://your-domain.com/

# 本地开发可改回：PAYMENT_MODE=mock

# --- 运营口令（生产禁止默认值）---
ADMIN_PASSWORD=请改成足够长的随机口令
BILLING_WEBHOOK_TOKEN=

# --- 单位经济：填真实 Coze 单次出图成本（元）---
# 算法建议：近 7 天 Coze 账单金额 ÷ 成功生成次数（含失败重试摊销）
ESTIMATED_COST_CNY_PER_GENERATION=0.50

# --- 首充 ---
FIRST_PURCHASE_DISCOUNT_ENABLED=true
FIRST_PURCHASE_DISCOUNT_FEN=200

# --- 生产存储（多实例必开）---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/huashangji
